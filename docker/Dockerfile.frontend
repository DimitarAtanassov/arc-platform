# syntax=docker/dockerfile:1
# Frontend (Next.js) image for arc-platform.
# Build from the repo root:  docker build -f docker/Dockerfile.frontend -t arc-platform-frontend .

FROM node:20-slim AS build
WORKDIR /srv/frontend

# NEXT_PUBLIC_* is inlined into the client bundle at build time, so the BFF base
# URL must be supplied as a build arg (the browser reaches it on the host port).
ARG NEXT_PUBLIC_API_BASE=http://localhost:8001
ENV NEXT_PUBLIC_API_BASE=${NEXT_PUBLIC_API_BASE}

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend ./
RUN npm run build

FROM node:20-slim AS runtime
WORKDIR /srv/frontend
ENV NODE_ENV=production
COPY --from=build /srv/frontend ./
EXPOSE 3000
CMD ["npm", "run", "start"]
