# arc-model-lab base URL. Read server-side only (never shipped to the browser);
# the Next server is the BFF and the only thing that reaches the model lab. The
# browser calls this app's own /api routes on the same origin.
MODEL_LAB_URL=http://localhost:8000

# Optional upstream timeouts (milliseconds).
# MODEL_LAB_TIMEOUT_MS=15000
# MODEL_LAB_INFERENCE_TIMEOUT_MS=120000
