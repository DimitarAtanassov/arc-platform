# ARC Research Console — deployment config. Copy to deploy/.env.
#
# This app needs to know where its two backends are reachable FROM the container.
# arc-model-lab and arc-eval-service are each deployed on their own, from their
# own repos; changing environments is a one-line URL change here.
#
#   - a service on your host:       http://host.docker.internal:8000
#   - a service deployed elsewhere: https://model-lab.example.internal
MODEL_LAB_URL=http://host.docker.internal:8000
EVAL_SERVICE_URL=http://host.docker.internal:8001

# Optional upstream timeouts (milliseconds).
# MODEL_LAB_TIMEOUT_MS=15000
# MODEL_LAB_INFERENCE_TIMEOUT_MS=120000
# EVAL_SERVICE_TIMEOUT_MS=15000
