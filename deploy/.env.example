# ARC Research Console — deployment config. Copy to deploy/.env.
#
# The only thing this app needs is where arc-model-lab is reachable FROM the
# container. arc-model-lab (and every other ARC service) is deployed on its own,
# from its own repo; changing environments is a one-line URL change here.
#
#   - model lab on your host:       http://host.docker.internal:8000
#   - model lab deployed elsewhere: https://model-lab.example.internal
MODEL_LAB_URL=http://host.docker.internal:8000

# Optional upstream timeouts (milliseconds).
# MODEL_LAB_TIMEOUT_MS=15000
# MODEL_LAB_INFERENCE_TIMEOUT_MS=120000
