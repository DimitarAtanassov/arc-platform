# ─────────────────────────────────────────────────────────────────────────
# ARC local stack configuration — copy to arc.env and fill in your keys.
#
#   cp deploy/arc.env.example deploy/arc.env   # then edit deploy/arc.env
#
# arc.env is gitignored: secrets live here and nowhere else. The judge-model
# and provider profiles reference keys BY ENV-VAR NAME, so the secret itself is
# only ever an environment value — never written into config, spans, or logs.
# Loaded by ./arc (the control script) and by deploy/docker-compose.yaml.
# ─────────────────────────────────────────────────────────────────────────

# --- Provider API keys (BYOK) ----------------------------------------------
# At least one is needed to call a real provider or to run LLM-as-judge scoring.
# Leave blank to run fully on the deterministic mock provider (no scoring).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Database (Postgres — the evaluator's system of record) -----------------
# Credentials for the bundled postgres service. The evaluator's connection URL
# (ARC_EVAL_DATABASE_URL) is derived from these in docker-compose.yaml, so the
# app and migrations always agree. Change the password before any shared use.
POSTGRES_USER=arc
POSTGRES_PASSWORD=arc
POSTGRES_DB=arc_eval

# --- Evaluator (LLM-as-judge, system of record) ----------------------------
# Judge-model profiles: a JSON list; api_key_env names the env var above.
ARC_EVAL_MODEL_PROFILES=[{"name":"default","provider":"anthropic","model":"claude-haiku-4-5","api_key_env":"ANTHROPIC_API_KEY"}]
ARC_EVAL_DEFAULT_MODEL=default
ARC_EVAL_DEFAULT_JUDGE=safety

# --- Gateway ---------------------------------------------------------------
# Default provider when an /v1/infer request omits one. The Playground can
# select any provider whose key is set above (mock is always available).
ARC_PROVIDER=mock
ARC_EVALUATOR_ENABLED=true
ARC_EVALUATOR_JUDGE=safety
ARC_EVALUATOR_MODEL=default

# --- Telemetry -------------------------------------------------------------
# Where the in-cluster collector forwards traces for offline judging.
ARC_EVAL_OTLP_ENDPOINT=http://evaluator:8000/v1/otlp/traces

# --- UI --------------------------------------------------------------------
# Baked into the browser bundle at build time; must be the host-published BFF.
NEXT_PUBLIC_API_BASE=http://localhost:8001
